# Copy this to .env and fill in your own values. Never commit the real .env.

# --- SQL Server / Dynamics NAV-style database (sql_utils.py, employee_lookup.py) ---
DB_SERVER=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Optional: NAV company-name prefix for table names, e.g. "Contoso Ltd"
# (used as "Contoso Ltd$User Setup"). Leave blank if your tables have no prefix.
NAV_COMPANY_NAME=

# --- Trello (skills/trello-read) ---
# Get a key/token at https://trello.com/app-key
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# The board to scope all lookups to (from its URL or the Trello API)
TRELLO_BOARD_ID=

# --- Outlook (skills/outlook-reply) ---
# Comma-separated shared mailbox names to search by default, e.g.:
# OUTLOOK_SHARED_MAILBOXES="Sales,Support,Billing"
OUTLOOK_SHARED_MAILBOXES=
